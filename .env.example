# The installer creates this file automatically. These are example values only.
APP_PASSWORD_HASH='$2y$10$replace-this-with-password-hash-output'
SESSION_SECRET='generate-at-least-32-random-bytes'
APP_PORT=3000
APP_DOMAIN=
SESSION_SECONDS=86400
RATE_LIMIT_FILE=/var/lib/clean-link/login-attempts.json

# auto adds Secure when HTTPS is detected through the reverse proxy.
COOKIE_SECURE=auto
